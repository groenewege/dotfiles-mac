#!/bin/zsh

set -e

# ------------------------------------------------------------
# Laravel Project Launcher
#
# Usage:
#   workon                    Current directory
#   workon my-project         ~/Sites/my-project
#   workon /path/to/project   Explicit path
# ------------------------------------------------------------

SITES_DIR="$HOME/Sites"

# ------------------------------------------------------------
# Resolve project directory
# ------------------------------------------------------------

if [[ -z "$1" ]]; then
    # No argument: use current directory
    PROJECT_DIR="$PWD"
elif [[ "$1" == /* ]]; then
    # Absolute path
    PROJECT_DIR="$1"
elif [[ "$1" == ~* ]]; then
    # Path starting with ~
    PROJECT_DIR="${1/#\~/$HOME}"
else
    # Project name: assume ~/Sites
    PROJECT_DIR="$SITES_DIR/$1"
fi

if [[ ! -d "$PROJECT_DIR" ]]; then
    echo "❌ Project directory does not exist:"
    echo "   $PROJECT_DIR"
    exit 1
fi

PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"
ENV_FILE="$PROJECT_DIR/.env"

# ------------------------------------------------------------
# Validation
# ------------------------------------------------------------

if [[ ! -f "$PROJECT_DIR/artisan" ]]; then
    echo "❌ Not a Laravel project:"
    echo "   $PROJECT_DIR"
    exit 1
fi

if [[ ! -f "$ENV_FILE" ]]; then
    echo "❌ No .env file found:"
    echo "   $ENV_FILE"
    exit 1
fi

# ------------------------------------------------------------
# Helpers
# ------------------------------------------------------------

env_value() {
    local value

    value=$(grep -E "^${1}=" "$ENV_FILE" | tail -1 | cut -d '=' -f2-)

    # Remove surrounding single or double quotes
    value="${value%\"}"
    value="${value#\"}"
    value="${value%\'}"
    value="${value#\'}"

    echo "$value"
}

# ------------------------------------------------------------
# Project configuration
# ------------------------------------------------------------

PROJECT_NAME="$(basename "$PROJECT_DIR")"

APP_URL="$(env_value APP_URL)"

DB_CONNECTION="$(env_value DB_CONNECTION)"
DB_HOST="$(env_value DB_HOST)"
DB_PORT="$(env_value DB_PORT)"
DB_DATABASE="$(env_value DB_DATABASE)"
DB_USERNAME="$(env_value DB_USERNAME)"
DB_PASSWORD="$(env_value DB_PASSWORD)"

# Sensible Laravel/MySQL defaults
DB_HOST="${DB_HOST:-127.0.0.1}"
DB_PORT="${DB_PORT:-3306}"

# ------------------------------------------------------------
# Summary
# ------------------------------------------------------------

echo ""
echo "🚀 Opening $PROJECT_NAME"
echo ""
echo "   Directory: $PROJECT_DIR"
echo "   URL:       ${APP_URL:-not configured}"
echo "   Database:  ${DB_DATABASE:-not configured}"
echo ""

# ------------------------------------------------------------
# Zed
# ------------------------------------------------------------

echo "→ Zed"

zed -n "$PROJECT_DIR"

# ------------------------------------------------------------
# Tower
# ------------------------------------------------------------

echo "→ Tower"

gittower "$PROJECT_DIR"

# ------------------------------------------------------------
# Chrome
# ------------------------------------------------------------

if [[ -n "$APP_URL" ]]; then
    echo "→ Chrome"

    open -a "Google Chrome" "$APP_URL"
else
    echo "⚠️  Skipping Chrome: APP_URL is not configured"
fi

# ------------------------------------------------------------
# TablePlus
# ------------------------------------------------------------

if [[ "$DB_CONNECTION" == "mysql" && -n "$DB_DATABASE" ]]; then
    echo "→ TablePlus"

    DB_URL="mysql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}"

    open -a "TablePlus" "$DB_URL"
else
    echo "⚠️  Skipping TablePlus: MySQL database is not configured"
fi

# ------------------------------------------------------------
# T3 Code
#
# `t3 app` opens the project in the running desktop app (and
# adds it there if it's new). It fails when the app isn't
# running, so launch the app and retry until it answers.
# ------------------------------------------------------------

T3="$HOME/.t3/bin/t3"
T3_BUNDLE_ID="com.t3tools.t3code"

echo "→ T3 Code"

if [[ ! -x "$T3" ]]; then
    echo "⚠️  Skipping T3 Code: $T3 not found (open the app once to install it)"
elif "$T3" app "$PROJECT_DIR" >/dev/null 2>&1; then
    open -b "$T3_BUNDLE_ID"
else
    echo "   Starting T3 Code..."

    open -b "$T3_BUNDLE_ID"

    T3_OPENED=0

    for i in {1..60}; do
        sleep 0.5

        if "$T3" app "$PROJECT_DIR" >/dev/null 2>&1; then
            T3_OPENED=1
            break
        fi
    done

    if (( ! T3_OPENED )); then
        echo "⚠️  T3 Code did not respond; open $PROJECT_NAME there by hand"
    fi
fi

# ------------------------------------------------------------
# Done
# ------------------------------------------------------------

echo ""
echo "✓ $PROJECT_NAME opened."
